# Copy to apps/marketplace/.env and fill in the first section.

# === FILL THESE IN ===

# Instance origin, without a path.
NEXT_PUBLIC_SALEOR_URL=
# Comma-separated hosts allowed to install the app. An unset list accepts any.
ALLOWED_SALEOR_DOMAINS=
# Vendors stay on the Stripe Connect onboarding screen without it.
STRIPE_SECRET_KEY=

# === PUBLIC ORIGIN — set it when Saleor is remote ===

# Your tunnel URL, so the manifest URLs are reachable. Restart after a change.
# NEXT_PUBLIC_MARKETPLACE_VENDOR_URL=

# === LOCAL DEFAULTS ===

NEXT_PUBLIC_SALEOR_MARKETPLACE_CHANNEL_SLUG=default-channel
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3001/api/graphql
NEXT_PUBLIC_MARKETPLACE_STOREFRONT_URL=http://localhost:3000

MARKETPLACE_NODE_ENV=development
MARKETPLACE_PORT=3001
MARKETPLACE_BASE_PATH=
MARKETPLACE_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

MARKETPLACE_APP_CONFIG_PROVIDER=aws
SECRET_MANAGER_APP_CONFIG_PATH=/marketplace/app-config

# LocalStack: `pnpm localstack:up`
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SESSION_TOKEN=
AWS_REGION=ap-southeast-1
AWS_ENDPOINT_URL=http://localhost:4566

# Mailpit: `pnpm mailpit:up`, inbox at http://localhost:8025
MARKETPLACE_SMTP_HOST=localhost
MARKETPLACE_SMTP_PORT=1025
MARKETPLACE_SMTP_SECURE=false
MARKETPLACE_SMTP_USER=
MARKETPLACE_SMTP_PASSWORD=
MARKETPLACE_EMAIL_FROM="Nimara Dev <dev@nimara.local>"
MARKETPLACE_SUPERADMIN_EMAIL=admin@nimara.local

# === LEDGER — payouts only ===

# `pnpm db-ledger:up`, then `pnpm migrate:ledger`. An empty value skips both.
DATABASE_URL=postgresql://marketplace:marketplace@127.0.0.1:5434/marketplace_ledger

# === OPTIONAL — payments ===

# The storefront payment form needs it.
STRIPE_PUBLIC_KEY=
# Signing secret of the destination for /api/payments/stripe/webhooks
STRIPE_WEBHOOK_SIGNING_SECRET=
# Signing secret of the destination for /api/stripe/connect/webhook
MARKETPLACE_STRIPE_CONNECT_WEBHOOK_SECRET=
MARKETPLACE_STRIPE_CONNECT_DEFAULT_COUNTRY=US

# === OPTIONAL — Vercel Edge Config (MARKETPLACE_APP_CONFIG_PROVIDER=edge) ===

MARKETPLACE_APP_CONFIG_EDGE_KEY=marketplace-app-config
# MARKETPLACE_EDGE_CONFIG=
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=
VERCEL_EDGE_CONFIG_ID=
