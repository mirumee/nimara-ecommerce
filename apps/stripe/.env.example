# =============================================================================
# Nimara Stripe App — multi-tenant Saleor payment app.
# One deployment serves every Saleor instance in ALLOWED_DOMAINS; per-tenant
# Stripe keys are entered in the dashboard UI and stored per domain.
# =============================================================================

# === REQUIRED ===
# App environment; also the manifest app-id prefix (e.g. `LOCAL.stripe`).
ENVIRONMENT=LOCAL
# Comma-separated Saleor domains allowed to install the app. Wildcards allowed
# (`*.eu.saleor.cloud`, or `*` for any — do NOT use `*` in production).
ALLOWED_DOMAINS=

# Path prefix the app is served under (e.g. `/stripe` behind a gateway).
# Empty = root. Dev sets this per app automatically when running several.
BASE_PATH=

# === Config storage ===
# Where every installed Saleor's config is stored: `edge` (Vercel) or `file`.
CONFIG_PROVIDER=edge
# `file` provider only — path relative to the app (local dev without Vercel).
CONFIG_FILE_PATH=.saleor-app-config.json
# Optional; default in code: nimara-config
CONFIG_KEY=

# === Vercel Edge Config (required when CONFIG_PROVIDER=edge) ===
VERCEL_EDGE_CONFIG_ID=
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=

# === OPTIONAL — Observability ===
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
