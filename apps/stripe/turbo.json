{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^codegen", "^build"],
      "outputs": ["public/assets/**", "dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.production",
        ".env.development",
        "!.env*.local"
      ],
      "env": [
        "BUILD_TARGET",
        "ENVIRONMENT",
        "NEXT_PUBLIC_ENVIRONMENT",
        "BASE_PATH",
        "ALLOWED_DOMAINS",
        "CONFIG_PROVIDER",
        "CONFIG_FILE_PATH",
        "CONFIG_KEY",
        "VERCEL_EDGE_CONFIG_ID",
        "SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_DSN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_DEBUG"
      ],
      "passThroughEnv": [
        "STRIPE_SECRET_KEY",
        "SALEOR_APP_TOKEN",
        "SENTRY_AUTH_TOKEN",
        "VERCEL_ACCESS_TOKEN",
        "VERCEL_TEAM_ID"
      ]
    }
  }
}
