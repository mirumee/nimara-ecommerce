{
  "name": "automated-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:codecept": "codeceptjs run --steps",
    "test:codecept:def": "codeceptjs def",
    "lint:staged": "lint-staged"
  },
  "devDependencies": {
    "@nimara/config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "codeceptjs": "4.1.0",
    "dotenv": "17.4.2",
    "eslint": "^8.57.0",
    "eslint-plugin-playwright": "^2.11.0",
    "lint-staged": "^16.4.0",
    "playwright": "1.62.1",
    "tsx": "4.23.1"
  },
  "lint-staged": {
    "*.{js,cjs,ts,tsx}": "eslint --fix",
    "*.*": "prettier --write --ignore-unknown"
  },
  "engines": {
    "node": "24.x"
  },
  "type": "module"
}
