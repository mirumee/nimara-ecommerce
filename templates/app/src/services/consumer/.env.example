# The queue the dev server polls for the `consumer` service, and creates on
# LocalStack (`docker compose up -d localstack`). A deployed service is driven
# by an event source mapping, which reads none of this.
CONSUMER_QUEUE_URL=http://localhost:4566/000000000000/app-template-consumer

# The SDK reads these from the environment, not from the client options. Lambda
# injects them; dev has to state them. `test` is what LocalStack accepts.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Set to talk to LocalStack instead of AWS. Also what lets the dev server
# create the queue, which it must never do against a real account.
AWS_ENDPOINT_URL=http://localhost:4566
