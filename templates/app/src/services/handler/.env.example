# Variables this service reads. `pnpm env:init` appends them to `.env`.

# Where every installed Saleor's config is stored: `file` or `edge`.
CONFIG_PROVIDER=file

# `file` provider only — path relative to the app.
CONFIG_FILE_PATH=.saleor-app-config.json

# Key the config is stored under. Optional; defaults in code.
CONFIG_KEY=
