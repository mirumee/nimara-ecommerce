# The app's own variables. Each service documents its own beside its code, and
# `pnpm env:init` composes this file with all of them into `.env`.

# Where this app is deployed: `vercel` or `node`. Decides the build layout.
BUILD_TARGET=vercel

# local | development | staging | production. Also the manifest app-id prefix.
ENVIRONMENT=local

# Comma-separated Saleor domains allowed to install the app, e.g.
# store.saleor.cloud. Empty allows none. Wildcards (`*`, `*.saleor.cloud`)
# widen it and belong in local development only.
ALLOWED_DOMAINS=

# Path prefix the app is served under (e.g. `/my-app` behind a gateway).
# Empty = root. Dev sets it per service when the app runs several.
BASE_PATH=

# Dev server port
PORT=8000

# Optional: enables Sentry error reporting when set
SENTRY_DSN=

# Where every installed Saleor's config is stored: `file` or `edge`.
CONFIG_PROVIDER=file

# `file` provider only — path relative to the app.
CONFIG_FILE_PATH=.app-config.json

# Key the config is stored under. Optional; defaults in code.
CONFIG_KEY=

# The Saleor whose schema `pnpm codegen` generates the client from.
NEXT_PUBLIC_SALEOR_API_URL=
