{
  "name": "@nimara/ui",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "lint": "eslint . --ext .js,.ts,.tsx --fix",
    "lint:staged": "lint-staged",
    "ui:add": "pnpm dlx shadcn@latest add",
    "postui:add": "prettier --list-different --ignore-unknown --write . && eslint --quiet --fix ."
  },
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./config/*": "./src/config/*.ts",
    "./hooks": "./src/hooks/index.ts",
    "./styles/*": "./src/styles/*.css",
    "./lib/*": "./src/lib/*.ts",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tailwindcss/forms": "0.5.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "editorjs-html": "3.4.3",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.90.0",
    "react-markdown": "10.1.0",
    "string-strip-html": "13.7.7",
    "tailwind-merge": "2.6.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@nimara/config": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^8.57.0",
    "lint-staged": "^16.4.0",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "*.{js,cjs,ts,tsx}": "eslint --fix",
    "*.*": "prettier --write --ignore-unknown"
  }
}
